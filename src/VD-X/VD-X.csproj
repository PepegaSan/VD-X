<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Also run on newer .NET Desktop Runtimes (e.g. 10) when 8 is not installed. -->
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- VirtualDesktopAccessor.dll is x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <AssemblyName>VD-X</AssemblyName>
    <RootNamespace>VDX</RootNamespace>
    <Version>1.0.2</Version>
    <Product>VD-X</Product>
    <Company>PepegaSan</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <None Include="..\..\VirtualDesktopAccessor.dll" Link="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
